# 复制成 .env.local 后按需修改（.env.local 不进版本库）。
#
# ⚠️ NEXT_PUBLIC_* 会被**打进浏览器的那份 JS**，任何人都能在 DevTools 里看到 ——
#    所以这里只能放"地址"这种公开信息，API 密钥绝不能写在这里，
#    它属于后端（MathStoryboard/llm.local.json）。
#
# ⚠️ 改完要让 dev server 重启才生效：NEXT_PUBLIC_* 是构建期内联的，不是运行时读的。

# 用不用自带 Mock。false = 打真后端（Python / FastAPI，run_api.bat 起的那个）。
NEXT_PUBLIC_USE_MOCK=false

# 后端的访问前缀 —— 注意**不是**后端的地址，而是"本站代理后端"的路径前缀
# （rewrites 在 next.config.ts，真实地址也写在那儿）。
#
# 为什么不写成 http://localhost:8000：局域网里别人访问的是 10.x.x.x:3000，
# 而他浏览器里的 localhost 指**他自己那台机器** —— 数据拉不到、视频全 404。
# 写成同源前缀后，浏览器只跟 3000 说话，由 dev server 在同一台机器上转发给后端，
# 跨域（CORS）也一并消失了。
NEXT_PUBLIC_API_BASE_URL=/msb

# 服务端组件（分享页 /share/<slug>）拿数据要的是**绝对地址**：
# Node 的 fetch 不认相对路径，它也走不了浏览器那套代理。
# 只有"前后端在同一台机器上"时才用得上这一条。
MSB_API_INTERNAL_URL=http://127.0.0.1:8000

# 演示模式（可选，默认关）。
#
# 开了才会往工作台里塞预置的示例会话（SEED_THREADS），用于没有后端时的演示。
# 默认关的意思是：后端没起来时，界面老老实实显示"没有历史会话"，而不是一批假数据。
# NEXT_PUBLIC_DEMO_MODE=true
